// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 0 - comum; 1 - prestador; 2 - adm; 3 - associado

model Roles {
  id          String   @id @default(uuid())
  tipo_acesso Int[]
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id         String    @id @default(uuid())
  nome       String
  email      String    @unique
  senha      String
  cpfCnpj    String?   @unique
  customerId String?   @unique
  endereco   Endereco?
  photUrl    String?

  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  roles        Roles?
  treepycaches Treepycaches[]
  historico    Historico[]
  pagamentos   transacoesUser[]
  Calculadora  Calculadora[]
  cardToken    cardToken[]
}

model Endereco {
  id     Int    @id @default(autoincrement())
  rua    String
  numero String
  bairro String
  cidade String
  estado String
  pais   String
  cep    String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model florestas {
  id                    Int    @id @default(autoincrement())
  nome                  String
  qnt_arvores           Int
  treepycash_disponivel Float
  projeto               Int    @unique @default(autoincrement())
  codigo                String @unique
  lat                   String
  long                  String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  treepycaches Treepycaches[]
}

model Calculadora {
  id                    Int   @id @default(autoincrement())
  gas                   Float
  eletricidade          Float
  transporte_individual Float
  transporte_coletivo   Float
  alimentacao           Float
  residuos              Float
  total                 Float

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model precificacao {
  id             Int   @id @default(autoincrement())
  unid_trepycash Float

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Treepycaches {
  id      Int     @id @default(autoincrement())
  qnt     Float
  isValid Boolean

  florestaId Int
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  floresta   florestas @relation(fields: [florestaId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Historico {
  id        Int    @id @default(autoincrement())
  titulo    String
  descricao String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
}

enum metodo {
  CARTAO
  PIX
  BOLETO
}

// 0 - aguardando; 1 - aprovado; 3 - recusado

model transacoesUser {
  id          Int    @id @default(autoincrement())
  metodo      metodo
  status      Int
  orderId     String @unique
  valo_compra Float

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
}

model transacoes {
  id           Int    @id @default(autoincrement())
  orderId      String
  paymentType  String
  valorBruto   Float
  valorLiquido Float
  status       String
}

model cardToken {
  id               Int    @id @default(autoincrement())
  token            String
  creditCardNumber String
  creditCardBrand  String
  userId           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
